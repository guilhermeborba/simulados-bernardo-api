NODE_ENV=development
PORT=3333

POSTGRES_DB=simulados_bernardo
POSTGRES_USER=REPLACE_WITH_LOCAL_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

DATABASE_URL=postgresql://REPLACE_WITH_LOCAL_DATABASE_USER:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/simulados_bernardo?schema=public

FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
API_DOCS_ENABLED=true

# Importação própria de quizzes: ADMIN ACTIVE existente; não cria conta.
# Somente necessário para gravação; dry-run/inventário funcionam sem banco.
QUIZ_SEED_AUTHOR_EMAIL=REPLACE_WITH_EXISTING_ACTIVE_ADMIN_EMAIL

# Recuperação via Resend: ativar somente após configurar chave e remetente verificado.
# Nunca colocar chave real em arquivos versionados.
PASSWORD_RESET_ENABLED=false
# RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# MAIL_FROM=notifications@example.com
# Endpoint fixo em produção; transporte loopback disponível somente em testes.
RESEND_API_URL=https://api.resend.com/emails
